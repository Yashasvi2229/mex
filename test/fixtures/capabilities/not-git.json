{
  "schemaVersion": 1,
  "ok": true,
  "data": {
    "mexVersion": "0.7.2",
    "repository": {
      "initializationState": "not_git_repository",
      "graphIndexState": "unavailable",
      "wikiIndexState": "unavailable"
    },
    "capabilities": [
      {
        "id": "project_hub",
        "installed": true,
        "availability": "unavailable",
        "unavailableReason": {
          "code": "NOT_GIT_REPOSITORY",
          "detail": "Repository initialization is required before this capability can be used."
        }
      },
      {
        "id": "team_identity",
        "installed": true,
        "availability": "unavailable",
        "unavailableReason": {
          "code": "NOT_GIT_REPOSITORY",
          "detail": "Repository initialization is required before this capability can be used."
        }
      },
      {
        "id": "activity_read",
        "installed": true,
        "availability": "unavailable",
        "unavailableReason": {
          "code": "NOT_GIT_REPOSITORY",
          "detail": "Repository initialization is required before this capability can be used."
        }
      },
      {
        "id": "activity_record",
        "installed": true,
        "availability": "unavailable",
        "unavailableReason": {
          "code": "NOT_GIT_REPOSITORY",
          "detail": "Repository initialization is required before this capability can be used."
        }
      },
      {
        "id": "code_graph",
        "installed": true,
        "availability": "unavailable",
        "unavailableReason": {
