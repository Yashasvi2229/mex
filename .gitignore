# intentionally NOT ignored.
evaluate/live-agent/results/
evaluate/live-agent/*.log

# The suite fixture names a private subject repository and carries absolute local paths,
# so it stays out of the tree. `runner.mjs` takes `--suite <path>`.
evaluate/live-agent/suite.json

